@@ -0,0 +1,170 @@
+using System;
+
+namespace AnodyneSharp.Utilities
+{
+    /// <summary>
+    /// A 16.16 fixed point number (1.0 = 65536 raw): the gameplay maths' number type, in place of float, so the GBA
+    /// port (anodyne-cpp's fx, ecs.h) runs the same maths with integers and the two games still match bit for bit.
+    /// The rules, which both sides follow exactly:
+    ///   - whole numbers: raw = n * 65536; floats (constants): the float's value * 65536 rounded to nearest, halves away
+    ///     from zero (in double)
+    ///   - + and - wrap; * is (long)a * b / 65536 and / is ((long)a &lt;&lt; 16) / b, both truncating (so x * 0.5f is
+    ///     x / 2); dividing by zero gives int.MaxValue (a &gt;= 0) or int.MinValue
+    ///   - % is raw % raw; (int) truncates; Floor is raw &gt;&gt; 16; Ceiling is -((-raw) &gt;&gt; 16)
+    ///   - Sqrt: floor(sqrt(raw &lt;&lt; 16)), 0 for v &lt;= 0
+    ///   - Sin/Cos: the shared table (FixSin.cs), indexed by the angle in 1/4096 turns, rounded:
+    ///     (raw * 42722830 + 2^31) &gt;&gt; 32, wrapped
+    ///   - RandomUnit (in place of (float)NextDouble() / NextSingle()): ((long)Next() &lt;&lt; 16) / int.MaxValue
+    /// See FixVector2 for the vector rules (MonoGame's Vector2 maths in Fix).
+    /// </summary>
+    public readonly partial struct Fix : IComparable<Fix>, IEquatable<Fix>
+    {
+        public readonly int Raw;
+
+        private Fix(int raw)
+        {
+            Raw = raw;
+        }
+
+        public static Fix FromRaw(int raw) => new(raw);
+
+        public static readonly Fix Zero = new(0);
+        public static readonly Fix One = new(65536);
+        public static readonly Fix Pi = 3.14159265358979f;
+        public static readonly Fix TwoPi = 6.28318530717959f;
+
+        public static implicit operator Fix(int v) => new(unchecked(v << 16));
+
+        public static implicit operator Fix(float v)
+        {
+            double d = (double)v * 65536.0;
+            return new(d >= 0 ? (int)(d + 0.5) : -(int)(-d + 0.5));
+        }
+
+        public static explicit operator int(Fix v) => v.Raw / 65536;
+        public static explicit operator float(Fix v) => v.Raw * (1.0f / 65536.0f);
+
+        public static Fix operator +(Fix a, Fix b) => new(unchecked(a.Raw + b.Raw));
+        public static Fix operator -(Fix a, Fix b) => new(unchecked(a.Raw - b.Raw));
+        public static Fix operator -(Fix a) => new(unchecked(-a.Raw));
+        public static Fix operator *(Fix a, Fix b) => new(unchecked((int)(((long)a.Raw * b.Raw) / 65536)));
+        public static Fix operator *(Fix a, int n) => new(unchecked(a.Raw * n));
+        public static Fix operator *(int n, Fix a) => new(unchecked(a.Raw * n));
+        public static Fix operator /(Fix a, Fix b)
+        {
+            if (b.Raw == 0)
+            {
+                return new(a.Raw >= 0 ? int.MaxValue : int.MinValue);
+            }
+            return new(unchecked((int)(((long)a.Raw << 16) / b.Raw)));
+        }
+        public static Fix operator /(Fix a, int n) => n == 0 ? a / (Fix)n : new(a.Raw / n);
+        public static Fix operator %(Fix a, Fix b) => new(a.Raw % b.Raw);
+        public static Fix operator ++(Fix a) => a + One;
+        public static Fix operator --(Fix a) => a - One;
+
+        /// <summary>A number from content (a float, made Fix).</summary>
+        public static Fix Parse(string s) => float.Parse(s);
+
+        public static bool operator <(Fix a, Fix b) => a.Raw < b.Raw;
+        public static bool operator >(Fix a, Fix b) => a.Raw > b.Raw;
+        public static bool operator <=(Fix a, Fix b) => a.Raw <= b.Raw;
+        public static bool operator >=(Fix a, Fix b) => a.Raw >= b.Raw;
+        public static bool operator ==(Fix a, Fix b) => a.Raw == b.Raw;
+        public static bool operator !=(Fix a, Fix b) => a.Raw != b.Raw;
+
+        public int CompareTo(Fix other) => Raw.CompareTo(other.Raw);
+        public bool Equals(Fix other) => Raw == other.Raw;
+        public override bool Equals(object obj) => obj is Fix f && f.Raw == Raw;
+        public override int GetHashCode() => Raw;
+        public override string ToString() => ((float)this).ToString();
+
+        public static int Floor(Fix v) => v.Raw >> 16;
+        public static int Ceiling(Fix v) => -((-v.Raw) >> 16);
+        public static Fix Abs(Fix v) => v.Raw < 0 ? -v : v;
+        public static Fix Min(Fix a, Fix b) => a < b ? a : b;
+        public static Fix Max(Fix a, Fix b) => a > b ? a : b;
+        public static Fix Clamp(Fix v, Fix lo, Fix hi) => v < lo ? lo : (v > hi ? hi : v);
+        public static int Sign(Fix v) => v.Raw > 0 ? 1 : (v.Raw < 0 ? -1 : 0);
+        /// <summary>MathHelper.Lerp: a + (b - a) * amount.</summary>
+        public static Fix Lerp(Fix a, Fix b, Fix amount) => a + (b - a) * amount;
+
+        /// <summary>floor(sqrt(v)) of a 64-bit value, bit by bit (the port's ISqrt64).</summary>
+        internal static uint ISqrt(ulong v)
+        {
+            ulong root = 0;
+            ulong bit = 1UL << 62;
+            while (bit > v)
+            {
+                bit >>= 2;
+            }
+            while (bit != 0)
+            {
+                if (v >= root + bit)
+                {
+                    v -= root + bit;
+                    root = (root >> 1) + bit;
+                }
+                else
+                {
+                    root >>= 1;
+                }
+                bit >>= 2;
+            }
+            return (uint)root;
+        }
+
+        public static Fix Sqrt(Fix v) => v.Raw <= 0 ? Zero : new((int)ISqrt((ulong)v.Raw << 16));
+
+        /// <summary>sqrt(x^2 + y^2) in 64 bits (Vector2.Length).</summary>
+        public static Fix Length(Fix x, Fix y)
+        {
+            ulong sq = (ulong)((long)x.Raw * x.Raw) + (ulong)((long)y.Raw * y.Raw);
+            return new((int)ISqrt(sq));
+        }
+
+        /// <summary>(x^2 + y^2) &gt;&gt; 16 in 64 bits, saturating at int.MaxValue (Vector2.LengthSquared).</summary>
+        public static Fix LengthSquared(Fix x, Fix y)
+        {
+            long sq = ((long)x.Raw * x.Raw + (long)y.Raw * y.Raw) >> 16;
+            return new(sq > int.MaxValue ? int.MaxValue : (int)sq);
+        }
+
+        private static int SinIndex(Fix radians) => (int)(((long)radians.Raw * 42722830 + (1L << 31)) >> 32);
+
+        private static Fix SinAt(int i)
+        {
+            i &= 4095;
+            int j = i & 1023;
+            int v = (i & 1024) != 0 ? SinTable[1024 - j] : SinTable[j];
+            return new(i >= 2048 ? -v : v);
+        }
+
+        public static Fix Sin(Fix radians) => SinAt(SinIndex(radians));
+        public static Fix Cos(Fix radians) => SinAt(SinIndex(radians) + 1024);
+
+        /// <summary>In place of (float)rng.NextDouble() / rng.NextSingle(): one draw, in [0, 1).</summary>
+        public static Fix RandomUnit(Random rng) => new((int)(((long)rng.Next() << 16) / int.MaxValue));
+    }
+
+    /// <summary>MathF's functions on Fix, so gameplay code reads as it did.</summary>
+    public static class FMath
+    {
+        public static readonly Fix PI = MathF.PI;
+        public static readonly Fix Tau = MathF.Tau;
+        public static Fix Sqrt(Fix v) => Fix.Sqrt(v);
+        public static Fix Sin(Fix v) => Fix.Sin(v);
+        public static Fix Cos(Fix v) => Fix.Cos(v);
+        public static Fix Abs(Fix v) => Fix.Abs(v);
+        public static Fix Min(Fix a, Fix b) => Fix.Min(a, b);
+        public static Fix Max(Fix a, Fix b) => Fix.Max(a, b);
+        public static int Sign(Fix v) => Fix.Sign(v);
+        public static Fix Floor(Fix v) => Fix.Floor(v);
+        public static Fix Ceiling(Fix v) => Fix.Ceiling(v);
+        public static Fix Clamp(Fix v, Fix lo, Fix hi) => Fix.Clamp(v, lo, hi);
+        public static int Min(int a, int b) => Math.Min(a, b);
+        public static int Max(int a, int b) => Math.Max(a, b);
+        public static int Abs(int v) => Math.Abs(v);
+        public static int Sign(int v) => Math.Sign(v);
+    }
+}
