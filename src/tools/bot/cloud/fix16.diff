+++ b/AnodyneSharp/AnodyneSharp.Shared/Utilities/FixVector2.cs
@@ -0,0 +1,109 @@
+using Microsoft.Xna.Framework;
+using System;
+
+namespace AnodyneSharp.Utilities
+{
+    /// <summary>
+    /// MonoGame's Vector2 with Fix components, for positions, velocities and the like. Gameplay files alias it as
+    /// Vector2, so their maths reads as it did. MonoGame's rules carry over: v / s is each component times 1 / s,
+    /// Normalize is each component times 1 / Length() (a zero vector stays zero, where MonoGame's gives NaN), Length
+    /// and Distance are sqrt(x^2 + y^2) (in 64 bits), LengthSquared saturates. Converts to MonoGame's Vector2 (for
+    /// drawing) only explicitly, as a float compare of a converted position can round differently; MonoGame vectors
+    /// (whole numbers from points, UI) convert to it implicitly, like floats to Fix.
+    /// </summary>
+    public struct FixVector2 : IEquatable<FixVector2>
+    {
+        public Fix X;
+        public Fix Y;
+
+        public FixVector2(Fix x, Fix y)
+        {
+            X = x;
+            Y = y;
+        }
+
+        public FixVector2(Fix v)
+        {
+            X = v;
+            Y = v;
+        }
+
+        public static FixVector2 Zero => new(0, 0);
+        public static FixVector2 One => new(1, 1);
+        public static FixVector2 UnitX => new(1, 0);
+        public static FixVector2 UnitY => new(0, 1);
+
+        public static explicit operator Vector2(FixVector2 v) => new((float)v.X, (float)v.Y);
+        public static implicit operator FixVector2(Vector2 v) => new(v.X, v.Y);
+
+        public static FixVector2 operator +(FixVector2 a, FixVector2 b) => new(a.X + b.X, a.Y + b.Y);
+        public static FixVector2 operator -(FixVector2 a, FixVector2 b) => new(a.X - b.X, a.Y - b.Y);
+        public static FixVector2 operator -(FixVector2 a) => new(-a.X, -a.Y);
+        public static FixVector2 operator *(FixVector2 a, FixVector2 b) => new(a.X * b.X, a.Y * b.Y);
+        public static FixVector2 operator *(FixVector2 a, Fix s) => new(a.X * s, a.Y * s);
+        public static FixVector2 operator *(Fix s, FixVector2 a) => new(a.X * s, a.Y * s);
+        public static FixVector2 operator /(FixVector2 a, FixVector2 b) => new(a.X / b.X, a.Y / b.Y);
+        public static FixVector2 operator /(FixVector2 a, Fix s)
+        {
+            Fix factor = Fix.One / s;
+            return new(a.X * factor, a.Y * factor);
+        }
+
+        public static bool operator ==(FixVector2 a, FixVector2 b) => a.X == b.X && a.Y == b.Y;
+        public static bool operator !=(FixVector2 a, FixVector2 b) => !(a == b);
+
+        public bool Equals(FixVector2 other) => this == other;
+        public override bool Equals(object obj) => obj is FixVector2 v && this == v;
+        public override int GetHashCode() => HashCode.Combine(X.Raw, Y.Raw);
+        public override string ToString() => $"{{X:{X} Y:{Y}}}";
+
+        public Fix Length() => Fix.Length(X, Y);
+        public Fix LengthSquared() => Fix.LengthSquared(X, Y);
+
+        public void Normalize()
+        {
+            Fix factor = Fix.One / Length();
+            X *= factor;
+            Y *= factor;
+        }
+
+        public static FixVector2 Normalize(FixVector2 v)
+        {
+            v.Normalize();
+            return v;
+        }
+
+        public static Fix Distance(FixVector2 a, FixVector2 b) => Fix.Length(a.X - b.X, a.Y - b.Y);
+        public static Fix DistanceSquared(FixVector2 a, FixVector2 b) => Fix.LengthSquared(a.X - b.X, a.Y - b.Y);
+        public static Fix Dot(FixVector2 a, FixVector2 b) => a.X * b.X + a.Y * b.Y;
+        public static FixVector2 Lerp(FixVector2 a, FixVector2 b, Fix amount) => new(Fix.Lerp(a.X, b.X, amount), Fix.Lerp(a.Y, b.Y, amount));
+        public static FixVector2 Min(FixVector2 a, FixVector2 b) => new(Fix.Min(a.X, b.X), Fix.Min(a.Y, b.Y));
+        public static FixVector2 Max(FixVector2 a, FixVector2 b) => new(Fix.Max(a.X, b.X), Fix.Max(a.Y, b.Y));
+        public static FixVector2 Clamp(FixVector2 v, FixVector2 lo, FixVector2 hi) => new(Fix.Clamp(v.X, lo.X, hi.X), Fix.Clamp(v.Y, lo.Y, hi.Y));
+
+        /// <summary>Vector2.Transform(v, Matrix.CreateRotationZ(radians)): x cos - y sin, x sin + y cos.</summary>
+        public static FixVector2 Rotate(FixVector2 v, Fix radians)
+        {
+            Fix c = Fix.Cos(radians);
+            Fix s = Fix.Sin(radians);
+            return new(v.X * c + v.Y * -s, v.X * s + v.Y * c);
+        }
+
+        /// <summary>For drawing and other float code (not for gameplay compares).</summary>
+        public Vector2 ToXna() => (Vector2)this;
+
+        /// <summary>Vector2.ToPoint: each component truncated.</summary>
+        public Point ToPoint() => new((int)X, (int)Y);
