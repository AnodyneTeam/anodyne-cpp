+namespace AnodyneSharp.Utilities
+{
+    // A room's corner (plus an offset written for the 160x160 rooms), standing in for a Vector2 in code that adds
+    // positions to it: tl + offset and tl.X + n land where remap.py moved that spot in the wide room. Without wide
+    // rooms it's the same sums as the Vector2 it replaces.
+    public readonly struct RoomFrame
+    {
+        public readonly Microsoft.Xna.Framework.Point Grid;
+        public readonly FixVector2 Offset;
+
+        public RoomFrame(Microsoft.Xna.Framework.Point grid, FixVector2 offset)
+        {
+            Grid = grid;
+            Offset = offset;
+        }
+
+        public static RoomFrame Current(FixVector2 offset = default) => new(Registry.GlobalState.CurrentMapGrid, offset);
+
+        public FixVector2 At(FixVector2 local) => MapUtilities.RoomPos(Grid, Offset + local);
+        public FixVector2 Origin => At(FixVector2.Zero);
+        public RoomAxis X => new(this, true);
+        public RoomAxis Y => new(this, false);
+
+        public static FixVector2 operator +(RoomFrame f, FixVector2 v) => f.At(v);
+        public static FixVector2 operator -(RoomFrame f, FixVector2 v) => f.At(-v);
+        public static implicit operator FixVector2(RoomFrame f) => f.Origin;
+        public Microsoft.Xna.Framework.Point ToPoint() => Origin.ToPoint();
+    }
+
+    public readonly struct RoomAxis
+    {
+        private readonly RoomFrame _f;
+        private readonly bool _x;
+
+        public RoomAxis(RoomFrame f, bool x)
+        {
+            _f = f;
+            _x = x;
+        }
+
+        private Fix At(Fix v)
+        {
+            FixVector2 p = _f.At(_x ? new FixVector2(v, 0) : new FixVector2(0, v));
+            return _x ? p.X : p.Y;
+        }
+
+        public static Fix operator +(RoomAxis a, Fix v) => a.At(v);
+        public static Fix operator +(Fix v, RoomAxis a) => a.At(v);
+        public static Fix operator -(RoomAxis a, Fix v) => a.At(-v);
+        public static implicit operator Fix(RoomAxis a) => a.At(0);
+    }
+}
