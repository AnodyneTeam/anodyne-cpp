+
+        // Wide rooms: the maps and Entities.xml from tools/wide_rooms/remap.py's output (ANODYNE_WIDE_CONTENT, the
+        // anodyne-cpp checkout's old/ContentWide) instead of the built-in ones
+        private static Stream? WideContent(string path)
+        {
+            string? dir = Environment.GetEnvironmentVariable("ANODYNE_WIDE_CONTENT");
+            if (dir == null || !(path.StartsWith("Content.Maps.") || path == "Content.Entities.xml"))
+            {
+                return null;
+            }
+            string[] parts = path.Split('.');
+            string file = Path.Combine(dir, Path.Combine(parts[1..^2]), parts[^2] + "." + parts[^1]);
+            return File.Exists(file) ? File.OpenRead(file) : null;
+        }
     }
 #nullable restore
