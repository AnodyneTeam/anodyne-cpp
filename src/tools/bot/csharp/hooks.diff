+            if (GetTile(Layer.BG2, tile) != 0)
+            {
+                var t2 = _tileObjects[GetTile(Layer.BG2, tile)];
+                allow |= t2.allowCollisions;
+                if (t2.collisionEventType != AnodyneSharp.MapData.Tiles.CollisionEventType.NONE)
+                {
+                    ev = t2.collisionEventType;
+                }
+            }
+            return (allow, ev);
+        }
