--- a/AnodyneSharp/AnodyneSharp.Shared/MapData/Map.cs
+++ b/AnodyneSharp/AnodyneSharp.Shared/MapData/Map.cs
@@ -109,6 +109,28 @@ namespace AnodyneSharp.MapData
             return ret;
         }
 
+        /// <summary>Bot: the collision directions and event of a tile (BG, with BG2 on top when it is not empty).</summary>
+        public (Touching, CollisionEventType) GetTileClass(Point p)
+        {
+            if (p.X < 0 || p.Y < 0 || p.X >= WidthInTiles || p.Y >= HeightInTiles)
+            {
+                return (Touching.ANY, CollisionEventType.NONE); // off the map: a wall (keeps the bot's searches bounded)
+            }
+            Tile bg = _tileObjects[GetTile(Layer.BG, p)];
+            Touching al = bg.allowCollisions;
+            CollisionEventType ev = bg.collisionEventType;
+            int bg2 = GetTile(Layer.BG2, p);
+            if (bg2 != 0)
+            {
+                al |= _tileObjects[bg2].allowCollisions;
+                if (_tileObjects[bg2].collisionEventType != CollisionEventType.NONE)
+                {
+                    ev = _tileObjects[bg2].collisionEventType;
+                }
+            }
+            return (al, ev);
+        }
+
         public int GetTile(Layer layer, Point pos)
         {
             int current = mapLayers[(int)layer].GetTile(pos);
diff --git a/AnodyneSharp/AnodyneSharp.Shared/Sounds/SoundManager.cs b/AnodyneSharp/AnodyneSharp.Shared/Sounds/SoundManager.cs
index 8d04df6..67eaa8d 100644
--- a/AnodyneSharp/AnodyneSharp.Shared/Sounds/SoundManager.cs
+++ b/AnodyneSharp/AnodyneSharp.Shared/Sounds/SoundManager.cs
@@ -107,6 +107,14 @@ namespace AnodyneSharp.Sounds
 
         public static SoundEffectInstance PlaySoundEffect(params string[] names)
         {
+            if (AnodyneSharp.Recording.RecordingManager.Deterministic)
+            {
+                // Deterministic runs: pick among the sounds that exist, not just the ones not playing (which sounds are
+                // still playing follows the wall clock), so the random number drawn is the same every run.
+                var known = names.Where((n) => ResourceManager.GetSFX().ContainsKey(n)).ToArray();
+                if (known.Length == 0) return null;
+                return CreateSoundInstance(ResourceManager.GetSFX(known[GlobalState.RNG.Next(0, known.Length)]));
+            }
             var sfx = names.Select((n) => ResourceManager.GetSFX(n)).Where((n) => n != null).ToArray();
             if (sfx.Length == 0) return null;
 
